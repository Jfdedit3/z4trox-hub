-- Créer un effet de lueur
local function CreateGlow(parent)
    local glow = Instance.new("ImageLabel")
    glow.Name = tostring(math.random(100000, 999999))
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://4996891970"
    glow.ImageColor3 = Color3.fromRGB(0, 225, 255)
    glow.ImageTransparency = 0.85
    glow.Size = UDim2.new(1, 20, 1, 20)
    glow.Position = UDim2.new(0, -10, 0, -10)
    glow.Parent = parent
end

local function CreateButtonHoverEffect(button)
    button.MouseEnter:Connect(function()
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(button, tweenInfo, {
            BackgroundColor3 = Color3.fromRGB(72, 77, 181),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        })
        tween:Play()
    end)

    button.MouseLeave:Connect(function()
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(button, tweenInfo, {
            BackgroundColor3 = Color3.fromRGB(42, 47, 91),
            TextColor3 = Color3.fromRGB(230, 230, 230)
        })
        tween:Play()
    end)
end

