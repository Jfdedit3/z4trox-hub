    local function CreateEnhancedButton(text, position)
        local button = Instance.new("TextButton")
        button.Name = GenerateUID()
        button.Position = position
        button.Size = UDim2.new(0, 100, 1, 0)
        button.BackgroundColor3 = Color3.fromRGB(42, 47, 91)
        button.BorderColor3 = Color3.fromRGB(0, 225, 255)
        button.BorderSizePixel = 1
        button.Font = Enum.Font.GothamBold
        button.Text = text
        button.TextColor3 = Color3.fromRGB(230, 230, 230)
        button.TextSize = 14
        button.Parent = ButtonContainer
        
        local cornerRadius = Instance.new("UICorner")
        cornerRadius.CornerRadius = UDim.new(0, 4)
        cornerRadius.Parent = button
        
        -- Add hover and click effects
        button.MouseEnter:Connect(function()
            Tween(button, {
                BackgroundColor3 = Color3.fromRGB(72, 77, 181),
                TextColor3 = Color3.fromRGB(255, 255, 255)
            })
        end)
        
        button.MouseLeave:Connect(function()
            Tween(button, {
                BackgroundColor3 = Color3.fromRGB(42, 47, 91),
                TextColor3 = Color3.fromRGB(230, 230, 230)
            })
        end)
        
        button.MouseButton1Down:Connect(function()
            Tween(button, {
                BackgroundColor3 = Color3.fromRGB(32, 37, 71)
            }, 0.1)
        end)
        
        button.MouseButton1Up:Connect(function()
            Tween(button, {
                BackgroundColor3 = Color3.fromRGB(72, 77, 181)
            }, 0.1)
        end)
        
        return button
    end
    
    local RunButton = CreateEnhancedButton("EXECUTE", UDim2.new(0, 0, 0, 0))
    local ClearButton = CreateEnhancedButton("CLEAR", UDim2.new(0, 110, 0, 0))
    local InjectButton = CreateEnhancedButton("INJECT", UDim2.new(0, 220, 0, 0))
    
    -- Add visual effects
    CreateHologramEffect(Main)
    local particleEmitter = CreateParticleEffect(Main)
    
    -- Implement core functionality
    local injected = false
    
    local function AnimateTitle(newText, duration)
        local originalText = Title.Text
        Title.Text = newText
        wait(duration)
        Title.Text = originalText
    end
    
    RunButton.MouseButton1Click:Connect(function()
        if injected then
            local success, error = pcall(function()
                loadstring(TextBox.Text)()
            end)
            if not success then
                AnimateTitle("Error: " .. error, 2)
            else
                local successParticles = CreateParticleEffect(RunButton)
                wait(1)
                successParticles:Destroy()
            end
        else
            AnimateTitle("NOT INJECTED", 2)
        end
    end)
    
    ClearButton.MouseButton1Click:Connect(function()
        TextBox.Text = ""
        local clearParticles = CreateParticleEffect(ClearButton)
        wait(0.5)
        clearParticles:Destroy()
    end)
    
    InjectButton.MouseButton1Click:Connect(function()
        if not injected then
            local steps = {
                {"INITIALIZING...", 0.5},
                {"BYPASSING SECURITY...", 0.7},
                {"ESTABLISHING CONNECTION...", 0.8},
                {"AUTHENTICATING...", 0.6},
                {"INJECTION SUCCESSFUL", 1}
            }
            
            for _, step in ipairs(steps) do
                AnimateTitle(step[1], step[2])
                local stepParticles = CreateParticleEffect(InjectButton)
                wait(step[2])
                stepParticles:Destroy()
            end
            
            injected = true
            Title.Text = "Z4TROX EXECUTOR V2 | INJECTED"
        else
            AnimateTitle("ALREADY INJECTED", 2)
        end
    end)
    
    -- Add keybind functionality
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == DeleteKeybind then
            Tween(Main, {
                BackgroundTransparency = 1,
                Position = UDim2.new(0.5, -225, 1.5, 0)
            }, 0.5).Completed:Connect(function()
                Executor:Destroy()
            end)
        elseif input.KeyCode == ToggleKeybind then
            Main.Visible = not Main.Visible
        end
    end)
    
    return Executor
end

