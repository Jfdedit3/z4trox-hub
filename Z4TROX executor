-- Animation de titre
local function AnimateTitle(newText, duration)
    local originalText = Title.Text
    Title.Text = newText
    wait(duration)
    Title.Text = originalText
end

-- Gestionnaires d'événements
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == DeleteKeybind then
        local fadeOut = TweenService:Create(Main, TweenInfo.new(0.5), {BackgroundTransparency = 1})
        fadeOut:Play()
        fadeOut.Completed:Connect(function()
            Krampus:Destroy()
        end)
    elseif input.KeyCode == ToggleKeybind then
        Main.Visible = not Main.Visible
    end
end)

