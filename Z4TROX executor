local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

-- Utility functions
local function GenerateUID()
    return tostring(math.random(100000, 999999))
end

local function Tween(object, properties, duration, style, direction)
    local tweenInfo = TweenInfo.new(duration or 0.3, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

-- Enhanced visual effects
local function CreateParticleEffect(parent)
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxassetid://6883806528"
    emitter.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 225, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 150, 255))
    })
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 0)
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    emitter.Rate = 50
    emitter.Rotation = NumberRange.new(-180, 180)
    emitter.RotSpeed = NumberRange.new(-360, 360)
    emitter.Speed = NumberRange.new(0.5, 2)
    emitter.Lifetime = NumberRange.new(0.5, 1)
    emitter.SpreadAngle = Vector2.new(-360, 360)
    emitter.Parent = parent
    
    return emitter
end

local function CreateHologramEffect(parent)
    local hologram = Instance.new("Frame")
    hologram.BackgroundTransparency = 0.9
    hologram.BackgroundColor3 = Color3.fromRGB(0, 225, 255)
    hologram.BorderSizePixel = 0
    hologram.Size = UDim2.new(1, 0, 0, 2)
    hologram.Parent = parent
    
    local function animate()
        local tween = Tween(hologram, {
            Position = UDim2.new(0, 0, 1, 0),
            BackgroundTransparency = 1
        }, 2)
        tween.Completed:Connect(function()
            hologram.Position = UDim2.new(0, 0, 0, 0)
            hologram.BackgroundTransparency = 0.9
            animate()
        end)
    end
    
    animate()
    return hologram
end

